{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make check)",
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(.venv/bin/ruff check:*)",
      "Bash(ruff check:*)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Bash(cat **/.env:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push * --force:*)",
      "Bash(git push * -f:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform -chdir=infra destroy:*)"
    ]
  }
}
